@model List<ABCRetail.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="page-header">
    <div>
        <h1>Customers</h1>
       
    </div>

    <div>
        <a asp-action="Create" class="btn btn-primary">
            + Add New Customer
        </a>
    </div>
</div>

<div class="content-card">

    <div class="content-card-header">
        <div>
            <h3>Customer Records</h3>
            <p>View registered ABC Retail customers.</p>
        </div>

        <span class="record-count">
            @Model.Count customer@(Model.Count == 1 ? "" : "s")
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table modern-table align-middle">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>
                                <div class="customer-name">
                                    <div class="customer-avatar">
                                        @customer.FirstName.Substring(0, 1).ToUpper()
                                    </div>

                                    <div>
                                        <strong>
                                            @customer.FirstName @customer.LastName
                                        </strong>
                                        <small>Customer</small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @customer.Email
                            </td>

                            <td>
                                @customer.PhoneNumber
                            </td>

                            <td>
                                @customer.Address
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">👥</div>
            <h3>No Customers Found</h3>
            <p>
                There are currently no customer records available.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Add Your First Customer
            </a>
        </div>
    }

</div>