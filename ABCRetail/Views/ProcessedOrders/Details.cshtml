@model ABCRetail.Models.ProcessedOrder

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Order Details</h1>

            <p class="text-muted mb-0">
                Detailed information about the processed order.
            </p>
        </div>

        <a asp-controller="ProcessedOrders"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Orders
        </a>

    </div>

    <div class="card">

        <div class="card-header">
            <h5 class="mb-0">
                Order Information
            </h5>
        </div>

        <div class="card-body">

            <div class="row">

                <!-- Order ID -->
                <div class="col-md-6 mb-3">

                    <strong>Order ID</strong>

                    <div class="form-control bg-light">
                        @Model.OrderId
                    </div>

                </div>

                <!-- Customer ID -->
                <div class="col-md-6 mb-3">

                    <strong>Customer ID</strong>

                    <div class="form-control bg-light">
                        @Model.CustomerId
                    </div>

                </div>

                <!-- Product ID -->
                <div class="col-md-6 mb-3">

                    <strong>Product ID</strong>

                    <div class="form-control bg-light">
                        @Model.ProductId
                    </div>

                </div>

                <!-- Quantity -->
                <div class="col-md-6 mb-3">

                    <strong>Quantity</strong>

                    <div class="form-control bg-light">
                        @Model.Quantity
                    </div>

                </div>

                <!-- Total Amount -->
                <div class="col-md-6 mb-3">

                    <strong>Total Amount</strong>

                    <div class="form-control bg-light">
                        R @Model.TotalAmount.ToString("N2")
                    </div>

                </div>

                <!-- Order Date -->
                <div class="col-md-6 mb-3">

                    <strong>Order Date</strong>

                    <div class="form-control bg-light">
                        @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                    </div>

                </div>

                <!-- Status -->
                <div class="col-md-6 mb-3">

                    <strong>Status</strong>

                    <div class="form-control bg-light">
                        <span class="badge bg-success">
                            @Model.Status
                        </span>
                    </div>

                </div>

                <!-- Partition Key -->
                <div class="col-md-6 mb-3">

                    <strong>Partition Key</strong>

                    <div class="form-control bg-light">
                        @Model.PartitionKey
                    </div>

                </div>

                <!-- Row Key -->
                <div class="col-md-6 mb-3">

                    <strong>Row Key</strong>

                    <div class="form-control bg-light">
                        @Model.RowKey
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>