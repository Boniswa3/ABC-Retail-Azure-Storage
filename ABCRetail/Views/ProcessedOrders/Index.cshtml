
@model IEnumerable<ABCRetail.Models.ProcessedOrder>

@{
    ViewData["Title"] = "Processed Orders";
}

<!-- PAGE HEADER -->
<div class="page-header">

    <div>
        <h1>Processed Orders</h1>

       
    </div>

</div>


<!-- SEARCH CARD -->
<div class="content-card processed-search-card">

    <div class="content-card-header">

        <div>
            <h3>Search Orders</h3>

            <p>
                Search and filter processed orders using the available criteria.
            </p>
        </div>

    </div>


    <form asp-controller="ProcessedOrders"
          asp-action="Index"
          method="get">

        <div class="row g-3">

            <!-- CUSTOMER ID -->
            <div class="col-md-3">

                <label for="customerId"
                       class="form-label">
                    Customer ID
                </label>

                <input type="text"
                       id="customerId"
                       name="customerId"
                       value="@ViewBag.CustomerId"
                       class="form-control"
                       placeholder="e.g. 002" />

            </div>


            <!-- PRODUCT ID -->
            <div class="col-md-3">

                <label for="productId"
                       class="form-label">
                    Product ID
                </label>

                <input type="text"
                       id="productId"
                       name="productId"
                       value="@ViewBag.ProductId"
                       class="form-control"
                       placeholder="e.g. 005" />

            </div>


            <!-- STATUS -->
            <div class="col-md-3">

                <label for="status"
                       class="form-label">
                    Status
                </label>

                <select id="status"
                        name="status"
                        class="form-select">

                    <option value="">
                        All Statuses
                    </option>

                    <option value="Processed"
                            selected="@(ViewBag.Status == "Processed")">
                        Processed
                    </option>

                </select>

            </div>


            <!-- SEARCH BUTTONS -->
            <div class="col-md-3 processed-search-actions">

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

                <a asp-controller="ProcessedOrders"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Clear
                </a>

            </div>

        </div>

    </form>

</div>


<!-- RESULTS CARD -->
<div class="content-card processed-results-card">

    <div class="content-card-header">

        <div>
            <h3>Processed Order Records</h3>

            <p>
                View orders that have been successfully processed.
            </p>
        </div>


        @if (Model != null)
        {
            <span class="record-count">
                @Model.Count() order@(Model.Count() == 1 ? "" : "s")
            </span>
        }

    </div>


    @if (Model != null && Model.Any())
    {

        <!-- TABLE -->
        <div class="table-responsive">

            <table class="table modern-table">

                <thead>

                    <tr>

                        <th>
                            Order ID
                        </th>

                        <th>
                            Customer ID
                        </th>

                        <th>
                            Product ID
                        </th>

                        <th>
                            Quantity
                        </th>

                        <th>
                            Total Amount
                        </th>

                        <th>
                            Order Date
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var order in Model)
                    {

                        <tr>

                            <td>
                                <strong class="order-id">
                                    @order.OrderId
                                </strong>
                            </td>


                            <td>
                                @order.CustomerId
                            </td>


                            <td>
                                @order.ProductId
                            </td>


                            <td>
                                @order.Quantity
                            </td>


                            <td>
                                <strong class="order-amount">
                                    R @order.TotalAmount.ToString("N2")
                                </strong>
                            </td>


                            <td>
                                @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>


                            <td>

                                <span class="processed-status">
                                    @order.Status
                                </span>

                            </td>


                            <td>

                                <a asp-controller="ProcessedOrders"
                                   asp-action="Details"
                                   asp-route-partitionKey="@order.PartitionKey"
                                   asp-route-rowKey="@order.RowKey"
                                   class="btn btn-primary btn-sm">
                                    Details
                                </a>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    }

    else
    {

        <!-- EMPTY STATE -->
        <div class="empty-state">

            <div class="empty-icon">
                📋
            </div>

            <h3>
                No Processed Orders Found
            </h3>

            <p>
                No processed orders were found matching your search criteria.
            </p>

        </div>

    }

</div>

