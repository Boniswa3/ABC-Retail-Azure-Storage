@model IEnumerable<ABCRetail.Models.ProcessedOrder>

@{
    ViewData["Title"] = "Processed Orders";
}

<div class="container mt-4">

    <h1>Processed Orders</h1>

    <p class="text-muted">
        Orders successfully processed by the Azure Function.
    </p>

    <!-- Search and Filter Form -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">Search Orders</h5>
        </div>

        <div class="card-body">

            <form asp-controller="ProcessedOrders"
                  asp-action="Index"
                  method="get">

                <div class="row">

                    <!-- Customer ID -->
                    <div class="col-md-3 mb-3">

                        <label for="customerId"
                               class="form-label">
                            Customer ID
                        </label>

                        <input type="text"
                               id="customerId"
                               name="customerId"
                               value="@ViewBag.CustomerId"
                               class="form-control"
                               placeholder="e.g. 002" />

                    </div>

                    <!-- Product ID -->
                    <div class="col-md-3 mb-3">

                        <label for="productId"
                               class="form-label">
                            Product ID
                        </label>

                        <input type="text"
                               id="productId"
                               name="productId"
                               value="@ViewBag.ProductId"
                               class="form-control"
                               placeholder="e.g. 005" />

                    </div>

                    <!-- Status -->
                    <div class="col-md-3 mb-3">

                        <label for="status"
                               class="form-label">
                            Status
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">

                            <option value="">
                                All Statuses
                            </option>

                            <option value="Processed"
                                    selected="@(ViewBag.Status == "Processed")">
                                Processed
                            </option>

                        </select>

                    </div>

                    <!-- Buttons -->
                    <div class="col-md-3 mb-3 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary me-2">
                            Search
                        </button>

                        <a asp-controller="ProcessedOrders"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Clear
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Results -->
    @if (Model != null && Model.Any())
    {
        <div class="mb-3">

            <strong>
                @Model.Count()
            </strong>

            processed order(s) found.

        </div>

        <div class="table-responsive">

            <table class="table table-striped table-bordered">

                <thead>
                    <tr>

                        <th>Order ID</th>
                        <th>Customer ID</th>
                        <th>Product ID</th>
                        <th>Quantity</th>
                        <th>Total Amount</th>
                        <th>Order Date</th>
                        <th>Status</th>
                        <th>Actions</th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in Model)
                    {
                        <tr>

                            <td>
                                @order.OrderId
                            </td>

                            <td>
                                @order.CustomerId
                            </td>

                            <td>
                                @order.ProductId
                            </td>

                            <td>
                                @order.Quantity
                            </td>

                            <td>
                                R @order.TotalAmount.ToString("N2")
                            </td>

                            <td>
                                @order.OrderDate.ToString(
                                "dd/MM/yyyy HH:mm")
                    </td>

                    <td>

                        <span class="badge bg-success">
                            @order.Status
                        </span>

                    </td>

                    <td>
                        <a asp-controller="ProcessedOrders"
                           asp-action="Details"
                           asp-route-partitionKey="@order.PartitionKey"
                           asp-route-rowKey="@order.RowKey"
                           class="btn btn-primary btn-sm">
                            Details
                        </a>
                    </td>

                </tr>
                                }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">

            No processed orders were found
            matching your search criteria.

        </div>
    }

</div>
