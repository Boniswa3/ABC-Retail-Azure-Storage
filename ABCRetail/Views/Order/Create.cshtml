@model ABCRetail.Models.Order

@{
    ViewData["Title"] = "Create Order";
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h1>Create Order</h1>
        <p class="page-subtitle">
            Create a new customer order and capture the required order details.
        </p>
    </div>
</div>


<!-- SUCCESS MESSAGE -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success order-alert">
        <strong>Success!</strong>
        @TempData["Success"]
    </div>
}


<!-- ORDER FORM CARD -->
<div class="content-card order-form-card">

    <div class="content-card-header">
        <div>
            <h3>Order Details</h3>
            <p>
                Enter the customer, product and order information below.
            </p>
        </div>

        <span class="order-badge">
            New Order
        </span>
    </div>


    <form asp-action="Create" method="post">

        <div class="row g-4">

            <!-- CUSTOMER ID -->
            <div class="col-md-6">

                <div class="order-form-group">

                    <label asp-for="CustomerId" class="form-label">
                        Customer ID
                    </label>

                    <input asp-for="CustomerId"
                           class="form-control"
                           placeholder="Enter customer ID" />

                    <small class="form-help">
                        Enter the ID of the customer placing the order.
                    </small>

                    <span asp-validation-for="CustomerId"
                          class="text-danger"></span>

                </div>

            </div>


            <!-- PRODUCT ID -->
            <div class="col-md-6">

                <div class="order-form-group">

                    <label asp-for="ProductId" class="form-label">
                        Product ID
                    </label>

                    <input asp-for="ProductId"
                           class="form-control"
                           placeholder="Enter product ID" />

                    <small class="form-help">
                        Enter the ID of the product being ordered.
                    </small>

                    <span asp-validation-for="ProductId"
                          class="text-danger"></span>

                </div>

            </div>


            <!-- QUANTITY -->
            <div class="col-md-6">

                <div class="order-form-group">

                    <label asp-for="Quantity" class="form-label">
                        Quantity
                    </label>

                    <input asp-for="Quantity"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Enter quantity" />

                    <small class="form-help">
                        Specify how many units of the product are required.
                    </small>

                    <span asp-validation-for="Quantity"
                          class="text-danger"></span>

                </div>

            </div>


            <!-- TOTAL AMOUNT -->
            <div class="col-md-6">

                <div class="order-form-group">

                    <label asp-for="TotalAmount" class="form-label">
                        Total Amount
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            R
                        </span>

                        <input asp-for="TotalAmount"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="0.00" />

                    </div>

                    <small class="form-help">
                        Enter the total value of the order in South African Rand.
                    </small>

                    <span asp-validation-for="TotalAmount"
                          class="text-danger"></span>

                </div>

            </div>

        </div>


        <!-- ORDER SUMMARY -->
        <div class="order-summary">

            <div class="order-summary-icon">
                🛒
            </div>

            <div>
                <strong>Order Summary</strong>

                <p>
                    Please verify the customer ID, product ID, quantity and
                    total amount before submitting the order.
                </p>
            </div>

        </div>


        <!-- SUBMIT BUTTON -->
        <div class="order-form-actions">

            <button type="submit"
                    class="btn btn-primary">
                Create Order
            </button>

        </div>

    </form>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}