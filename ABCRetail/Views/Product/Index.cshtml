@model List<ABCRetail.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="page-header">
    <div>
        <h1>Products</h1>
       
    </div>

    <div>
        <a asp-action="Create" class="btn btn-primary">
            + Add New Product
        </a>
    </div>
</div>

<div class="content-card">

    <div class="content-card-header">
        <div>
            <h3>Product Catalogue</h3>
            <p>View products, prices, images and available stock.</p>
        </div>

        <span class="record-count">
            @Model.Count product@(Model.Count == 1 ? "" : "s")
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="product-grid">

            @foreach (var product in Model)
            {
                <div class="product-card">

                    <div class="product-image-container">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 class="product-image"
                                 alt="@product.ProductName" />
                        }
                        else
                        {
                            <div class="product-no-image">
                                <span>📦</span>
                                <small>No Image</small>
                            </div>
                        }
                    </div>

                    <div class="product-card-body">

                        <h3 class="product-title">
                            @product.ProductName
                        </h3>

                        <p class="product-description">
                            @product.Description
                        </p>

                        <div class="product-details">

                            <div>
                                <span class="product-label">Price</span>
                                <strong class="product-price">
                                    R @product.Price
                                </strong>
                            </div>

                            <div class="stock-info">
                                <span class="product-label">Stock</span>

                                @if (product.StockQuantity > 0)
                                {
                                    <span class="stock-badge">
                                        @product.StockQuantity available
                                    </span>
                                }
                                else
                                {
                                    <span class="stock-badge out-of-stock">
                                        Out of stock
                                    </span>
                                }
                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📦</div>

            <h3>No Products Found</h3>

            <p>
                There are currently no products in the catalogue.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Add Your First Product
            </a>
        </div>
    }

</div>